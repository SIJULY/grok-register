# 2Captcha 客户端密钥（用于绕过 Cloudflare Turnstile）
# 注册地址：https://2captcha.com/?from=22363148
TWOCAPTCHA_KEY="your_twocaptcha_key"

# 邮箱提供商：domain / gptmail / luckmail / mailnest
EMAIL_PROVIDER="domain"

# 自建域名邮箱（HTTP 拉信接口模式，EMAIL_PROVIDER=domain 时使用）
# 你的接口格式类似：http://89.168.116.152:2099/Mail?token=2088&mail=xxx@domain.com
# 注意：DOMAIN_MAIL_DOMAIN 请改成你实际接收邮件的域名，例如 example.com
DOMAIN_MAIL_DOMAIN="lahtim.io"
DOMAIN_MAIL_API_URL="http://92.5.82.166:2099/Mail?token=2088&mail={mail}"
DOMAIN_MAIL_PREFIX="grok"
DOMAIN_MAIL_RANDOM_LENGTH="10"
DOMAIN_MAIL_API_TIMEOUT="15"

# Grok 注册线程数（可选）
THREADS="1"

# LuckMail 配置（仅在 EMAIL_PROVIDER=luckmail 时需要）
# LUCKMAIL_BASE_URL 已内置为 https://mails.luckyous.com，只有使用别的站点时才需要覆盖
# LUCKMAIL_BASE_URL="https://mails.luckyous.com"
LUCKMAIL_API_KEY="your_luckmail_api_key"
LUCKMAIL_API_SECRET=""
LUCKMAIL_USE_HMAC="false"
LUCKMAIL_PROJECT_CODE="grok"
LUCKMAIL_EMAIL_TYPE="ms_imap"
LUCKMAIL_DOMAIN="outlook.com"

# MailNest 配置（仅在 EMAIL_PROVIDER=mailnest 时需要）
# 获取 apikey：https://mailnest.top/account
# 获取项目代码：https://mailnest.top/buy-email 默认为 x-ai001 可直接使用
MAILNEST_API_KEY="your_mailnest_api_key"
MAILNEST_PROJECT_CODE="x-ai001"

# 可选代理示例（如需可自行启用）
# 项目代码实际优先读取 GROK_PROXY；默认 http://127.0.0.1:7897
# 如不使用代理，可设置为 none/direct/false/0/no
# GROK_PROXY="none"
GROK_PROXY="http://127.0.0.1:7897"
# HTTP_PROXY="http://127.0.0.1:7890"
# HTTPS_PROXY="http://127.0.0.1:7890"

# macOS / Linux / Windows 通用路径配置
# OAuth token JSON 保存目录。默认是项目目录下 ./auths
# GROK_AUTH_DIR="./auths"

# grok2api SQLite 数据库路径。默认是 ~/grok2api/data/backend.db
# 如果你的 grok2api 安装在其他位置，请改成真实 backend.db 路径。
# GROK2API_DB="~/grok2api/data/backend.db"

# grok2api 管理后台配置（auto_replenish.py 导入账号池时使用）
GROK2API_BASE="http://127.0.0.1:8000"
GROK2API_USER="admin"
GROK2API_PASS=""

# CPA 自动上传配置（将无头转换完的账号自动投递到 CPA）
# 开启自动上传请将 GROK_AUTO_UPLOAD_CPA 设置为 true / 1
# GROK_AUTO_UPLOAD_CPA="true"
# GROK_CPA_API_URL="http://your-cpa-panel-url.com/v0/management/auth-files"
# GROK_CPA_API_TOKEN="your_cpa_token_here"

# 仅 PKCE + ruyipage fallback 需要；Device Flow 默认不依赖它
# macOS Firefox 默认路径：/Applications/Firefox.app/Contents/MacOS/firefox
# FIREFOX_BINARY="/Applications/Firefox.app/Contents/MacOS/firefox"
# RUYIPAGE_PATH="~/ruyipage"
